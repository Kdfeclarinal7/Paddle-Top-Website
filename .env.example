# Only public browser-side Supabase configuration.
# Copy to .env.local (do not commit your actual .env.local).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLIC_KEY"

# Google OAuth secrets are configured in Supabase/Google dashboards, never here.
